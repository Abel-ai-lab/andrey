__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/

*.egg-info/
build/
dist/

.venv*/
venv/
# The bench venv is built by benchmarks/start.sh, which pins competitor versions there.
# Its lockfile is an artifact of that build, and travels with a batch's results, not the repo.
benchmarks/uv.lock
# The R package library benchmarks/start_r.sh builds for the R lane, beside the venv.
benchmarks/.r-lib-bench/
# The authors' RESIT code that benchmarks/start_resit_r.sh fetches, read from disk and never committed.
benchmarks/.resit-r/
# The MVPC authors' R code that benchmarks/start_mvpc_r.sh fetches, read from disk and never committed.
benchmarks/.mvpc-r/
# MissDAG's code that benchmarks/start_missdag.sh fetches, read from disk and never committed.
benchmarks/.missdag/
# The tetrad-lib jar that benchmarks/start_tetrad_missing.sh fetches, read from disk and never committed.
benchmarks/.tetrad-missing/
# The authors' LOCI code that benchmarks/start_loci.sh fetches, read from disk and never committed.
benchmarks/.loci/
# The authors' NOTEARS code that benchmarks/start_notears.sh fetches, read from disk and never
# committed.
benchmarks/.notears/
# The authors' SCORE code that benchmarks/start_stein.sh fetches, read from disk and never committed.
benchmarks/.score/
env/

.vscode/
.idea/
*.swp
*.code-workspace
.DS_Store
Thumbs.db

.env
.envrc

*.log
*.out
tmp/
temp/
.cache/

# Local job scripts (e.g., SLURM submit scripts).
jobs/

outputs/

.claude/*
!.claude/CLAUDE.md
!.claude/commands
!.claude/skills


docs/PR/

# docs site: generated build artifacts (never committed, never shipped in the wheel)
docs/_build/
docs/_generated/
docs/docs/examples/*.ipynb
docs/docs/api/
docs/_static/andrey-tokens.css
docs/_static/graph-comparison.html
docs/_static/graph-types-*.html

.ipynb_checkpoints/
apps/live-discovery/brand/
apps/live-discovery/data/
# The authors' MMB-by-MMB code that benchmarks/start_mmb.sh fetches, read from disk and never
# committed.
benchmarks/.mmb/
# The authors' sbcd R code that benchmarks/start_sbcd_r.sh fetches, read from disk and never
# committed.
benchmarks/.sbcd-r/
# The authors' Causal Explorer toolbox that benchmarks/start_causal_explorer.sh fetches, run from
# disk and never committed.
benchmarks/.causal-explorer/
# The published networks' files that the network lanes fetch, read from disk and never committed.
benchmarks/.networks/
